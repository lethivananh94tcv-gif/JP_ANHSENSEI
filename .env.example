# ============================================================
# ANH SENSEI - Environment Variables Template (.env.example)
# DO NOT COMMIT REAL SECRETS TO GIT
# ============================================================

# Database Configuration (Supabase PostgreSQL / Local Postgres)
DATABASE_URL=jdbc:postgresql://localhost:5432/postgres?sslmode=prefer
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_database_password_here

# JWT Security
JWT_SIGNING_SECRET=your_jwt_secret_min_32_chars_long_random_string_here

# Supabase Storage Integration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# AI Provider (OpenAI / Compatible LLM)
AI_API_KEY=your_ai_provider_api_key_here

# Application Ports & URLs
BACKEND_PORT=8080
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
